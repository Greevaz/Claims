<Window x:Class="ClaimsCalculatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claims Interest Calculator" Height="720" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- ===================== CLAIM DETAILS ===================== -->
            <TabItem Header="Claim Details">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Client Name" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtClientName" Margin="0,5" Padding="4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Account / Reference No." Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtAccountRefNo" Margin="0,5" Padding="4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Policy No." Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtPolicyNo" Margin="0,5" Padding="4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Opening Balance (N$)" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtOpeningBalance" Margin="0,5" Padding="4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Loan Agreement Date" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="4" Grid.Column="1" x:Name="DpLoanAgreementDate" Margin="0,5" HorizontalAlignment="Left" Width="200"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Start Date" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="5" Grid.Column="1" x:Name="DpStartDate" Margin="0,5" HorizontalAlignment="Left" Width="200"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Date of Death" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="6" Grid.Column="1" x:Name="DpDateOfDeath" Margin="0,5" HorizontalAlignment="Left" Width="200"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Interest Rate (%) - used when&#10;Multiple Rates = No" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="TxtSingleRate" Margin="0,5" Padding="4" HorizontalAlignment="Left" Width="120"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Multiple Interest Rates&#10;in this period?" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <CheckBox Grid.Row="8" Grid.Column="1" x:Name="ChkMultipleRates" Content="Yes" Margin="0,10" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Claims Officer / Supervisor" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                            <TextBox x:Name="TxtClaimsOfficer" Width="200" Padding="4" Text="Anthony Greeves"/>
                            <TextBox x:Name="TxtSupervisor" Width="200" Padding="4" Margin="10,0,0,0" Text="Wesley Ramothibe"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== RATE CHANGES ===================== -->
            <TabItem Header="Rate Changes">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnAddRate" Content="Add Rate Change" Padding="8,4" Click="BtnAddRate_Click"/>
                        <Button x:Name="BtnRemoveRate" Content="Remove Selected" Padding="8,4" Margin="10,0,0,0" Click="BtnRemoveRate_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" FontStyle="Italic"
                               Text="Each new rate applies from its Effective Date onward, until the next Effective Date. Only used when 'Multiple Interest Rates' is checked."/>
                    <DataGrid x:Name="GridRateChanges" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Effective Date" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding EffectiveDate, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="New Rate (%)" Binding="{Binding NewRatePercent}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== PAYMENTS ===================== -->
            <TabItem Header="Payments Received">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnAddPayment" Content="Add Payment" Padding="8,4" Click="BtnAddPayment_Click"/>
                        <Button x:Name="BtnRemovePayment" Content="Remove Selected" Padding="8,4" Margin="10,0,0,0" Click="BtnRemovePayment_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="GridPayments" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Date" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding Date, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Amount (N$)" Binding="{Binding Amount}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== DOCUMENT CHECKLIST ===================== -->
            <TabItem Header="Document Checklist">
                <StackPanel Margin="15">
                    <TextBlock Text="Check off every document that has been collected for this claim."
                               FontStyle="Italic" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="ChecklistItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <!-- ===================== RESULTS ===================== -->
            <TabItem Header="Results">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Total Interest: " FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotalInterest" Text="N$ 0.00" VerticalAlignment="Center" Margin="0,0,30,0"/>
                        <TextBlock Text="Claim Amount Incl. Interest: " FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtClaimAmount" Text="N$ 0.00" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="GridSchedule" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd MMM yyyy}" Width="110"/>
                            <DataGridTextColumn Header="Opening Balance" Binding="{Binding OpeningBalance, StringFormat={}{0:#,##0.00}}" Width="120"/>
                            <DataGridTextColumn Header="Daily Interest" Binding="{Binding DailyInterest, StringFormat={}{0:#,##0.00}}" Width="110"/>
                            <DataGridTextColumn Header="Rate %" Binding="{Binding InterestRatePercent}" Width="70"/>
                            <DataGridTextColumn Header="Compound Interest" Binding="{Binding CompoundInterest, StringFormat={}{0:#,##0.00}}" Width="130"/>
                            <DataGridTextColumn Header="Payments" Binding="{Binding Payments, StringFormat={}{0:#,##0.00}}" Width="100"/>
                            <DataGridTextColumn Header="Closing Balance" Binding="{Binding ClosingBalance, StringFormat={}{0:#,##0.00}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== COVER LETTER ===================== -->
            <TabItem Header="Cover Letter">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="BtnGenerateLetter" Content="Generate Cover Letter" Padding="8,4" Click="BtnGenerateLetter_Click"/>
                        <Button x:Name="BtnSaveLetter" Content="Save Letter to File..." Padding="8,4" Margin="10,0,0,0" Click="BtnSaveLetter_Click"/>
                        <Button x:Name="BtnCopyLetter" Content="Copy to Clipboard" Padding="8,4" Margin="10,0,0,0" Click="BtnCopyLetter_Click"/>
                    </StackPanel>
                    <TextBox x:Name="TxtLetterOutput" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                             IsReadOnly="False"/>
                </DockPanel>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnCalculate" Content="Calculate" Padding="16,6" FontWeight="Bold" Click="BtnCalculate_Click"/>
            <TextBlock x:Name="TxtStatus" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="DarkRed"/>
        </StackPanel>
    </Grid>
</Window>
