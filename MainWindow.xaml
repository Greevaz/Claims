<Window x:Class="ClaimsCalculatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claims App" Height="720" Width="1000"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Language="en-GB" Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <!-- ===================== START MENU (initial view) ===================== -->
            <Grid x:Name="HomeGrid">
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="30">
                    <TextBlock Text="Home Page" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    <UniformGrid Columns="2" HorizontalAlignment="Center" MaxWidth="760">
                        <Button Content="Claims Calculator and Cover Page" Height="56" Margin="5" FontSize="16"
                                Click="BtnOpenClaimsCalculator_Click"/>
                        <Button Content="Database Records" Height="56" Margin="5" FontSize="16"
                                Click="BtnOpenDatabaseRecords_Click"/>
                        <Button Content="Update Approvals" IsEnabled="False" Height="56" Margin="5"/>
                        <Button Content="Update Rejections" IsEnabled="False" Height="56" Margin="5"/>
                        <Button Content="Letter to Magistrate" IsEnabled="False" Height="56" Margin="5"/>
                        <Button Content="Refund Interest Calculator" IsEnabled="False" Height="56" Margin="5"/>
                        <Button Content="Ex-Gratia Cover" IsEnabled="False" Height="56" Margin="5"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <Grid x:Name="DatabaseGrid" Visibility="Collapsed">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Back to Home" Padding="12,4"
                            HorizontalAlignment="Left" Margin="0,0,0,8"
                            Click="BtnBackToHome_Click"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="CmbDatabaseSearchField" Width="130" SelectedIndex="0" Margin="0,0,8,0">
                            <ComboBoxItem Content="AZ"/>
                            <ComboBoxItem Content="Name"/>
                            <ComboBoxItem Content="Client ID"/>
                        </ComboBox>
                        <TextBox x:Name="TxtDatabaseSearch" Width="220" Padding="4"
                                 KeyDown="TxtDatabaseSearch_KeyDown"
                                 PreviewTextInput="TxtDatabaseSearch_PreviewTextInput"
                                 DataObject.Pasting="TxtDatabaseSearch_Pasting"/>
                        <Button Content="Search" Padding="12,4" Margin="8,0,0,0"
                                Click="BtnSearchDatabase_Click"/>
                    </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Save to Excel" Padding="12,4" Click="BtnSaveClaim_Click"/>
                        <TextBlock Text="Edit any field below, then save. The AZ identifies the record and should not be changed."
                                   Margin="12,4,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="GridClaimFields" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Column" Binding="{Binding Name}" IsReadOnly="True" Width="260"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>

            <Button x:Name="BtnClaimsBack" Content="Back to Home Page" Padding="12,5"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                    Click="BtnBackToHome_Click"/>

            <TabControl x:Name="MainTabs" Visibility="Collapsed" Margin="0,38,0,0"
                        TabStripPlacement="Right">


            <!-- ===================== CLAIM DETAILS ===================== -->
            <TabItem x:Name="ClaimsCalculatorTab" Header="Claim Details">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="AZ" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="TxtAccountRefNo" Width="180" Margin="0,5" Padding="4"
                                 KeyDown="TxtAccountRefNo_KeyDown"
                                 PreviewTextInput="TxtAccountRefNo_PreviewTextInput"
                                 DataObject.Pasting="TxtAccountRefNo_Pasting"/>
                        <Button Content="Search" Padding="12,4" Margin="8,5,0,5"
                                Click="BtnSearchClaim_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Client Name" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtClientName" Margin="0,5" Padding="4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Policy No." Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtPolicyNo" Margin="0,5" Padding="4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Opening Balance (N$)" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtOpeningBalance" Margin="0,5" Padding="4"
                                 TextChanged="ClaimInputChanged"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Loan Agreement Date (from Loan Start Date)" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="4" Grid.Column="1" x:Name="DpLoanAgreementDate" Margin="0,5" HorizontalAlignment="Left" Width="200"
                                    SelectedDateFormat="Short"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Start Date" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="5" Grid.Column="1" x:Name="DpStartDate" Margin="0,5" HorizontalAlignment="Left" Width="200"
                                    SelectedDateFormat="Short" SelectedDateChanged="ClaimDateChanged"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Date of Death" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="6" Grid.Column="1" x:Name="DpDateOfDeath" Margin="0,5" HorizontalAlignment="Left" Width="200"
                                    SelectedDateFormat="Short"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Interest Rate (%) - used when&#10;Multiple Rates = No" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="TxtSingleRate" Margin="0,5" Padding="4" HorizontalAlignment="Left" Width="120"
                                 TextChanged="ClaimInputChanged"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Multiple Interest Rates&#10;in this period?" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <CheckBox Grid.Row="8" Grid.Column="1" x:Name="ChkMultipleRates" Content="Yes" Margin="0,10" VerticalAlignment="Center"
                                  Checked="ClaimOptionChanged" Unchecked="ClaimOptionChanged"/>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Claims Officer / Supervisor" Margin="0,8,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                            <TextBox x:Name="TxtClaimsOfficer" Width="200" Padding="4" Text="Anthony Greeves"/>
                            <TextBox x:Name="TxtSupervisor" Width="200" Padding="4" Margin="10,0,0,0" Text="Wesley Ramothibe"/>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== RATE CHANGES ===================== -->
            <TabItem x:Name="RateChangesTab" Header="Rate Changes">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnAddRate" Content="Add Rate Change" Padding="8,4" Click="BtnAddRate_Click"/>
                        <Button x:Name="BtnRemoveRate" Content="Remove Selected" Padding="8,4" Margin="10,0,0,0" Click="BtnRemoveRate_Click"/>
                        <Button x:Name="BtnSaveRates" Content="Save Rate Changes" Padding="8,4" Margin="10,0,0,0"
                                Click="BtnSaveRates_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" FontStyle="Italic"
                               Text="Each new rate applies from its Effective Date onward, until the next Effective Date. Only used when 'Multiple Interest Rates' is checked."/>
                    <DataGrid x:Name="GridRateChanges" AutoGenerateColumns="False" CanUserAddRows="False"
                              CellEditEnding="GridRateChanges_CellEditEnding"
                              Language="en-US"
                              PreviewTextInput="GridRateChanges_PreviewTextInput"
                              DataObject.Pasting="GridRateChanges_Pasting">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Effective Date" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding EffectiveDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    SelectedDateFormat="Short"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="New Rate (%)" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding NewRatePercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                 Language="en-US" GotFocus="RateTextBox_GotFocus"
                                                 PreviewTextInput="RateTextBox_PreviewTextInput"
                                                 DataObject.Pasting="RateTextBox_Pasting"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== PAYMENTS ===================== -->
            <TabItem x:Name="PaymentsTab" Header="Payments Received">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnAddPayment" Content="Add Payment" Padding="8,4" Click="BtnAddPayment_Click"/>
                        <Button x:Name="BtnRemovePayment" Content="Remove Selected" Padding="8,4" Margin="10,0,0,0" Click="BtnRemovePayment_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="GridPayments" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Date" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding Date, Mode=TwoWay}" SelectedDateFormat="Short"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Amount (N$)" Binding="{Binding Amount}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== DOCUMENT CHECKLIST ===================== -->
            <TabItem x:Name="ChecklistTab" Header="Document Checklist">
                <StackPanel Margin="15">
                    <TextBlock Text="Check off every document that has been collected for this claim."
                               FontStyle="Italic" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="ChecklistItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Checked="ClaimOptionChanged" Unchecked="ClaimOptionChanged" Margin="0,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <!-- ===================== RESULTS ===================== -->
            <TabItem x:Name="ResultsTab" Header="Results">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Total Interest: " FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotalInterest" Text="N$ 0.00" VerticalAlignment="Center" Margin="0,0,30,0"/>
                        <TextBlock Text="Claim Amount Incl. Interest: " FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtClaimAmount" Text="N$ 0.00" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="GridSchedule" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd MMM yyyy}" Width="110"/>
                            <DataGridTextColumn Header="Opening Balance" Binding="{Binding OpeningBalance, StringFormat={}{0:#,##0.00}}" Width="120"/>
                            <DataGridTextColumn Header="Daily Interest" Binding="{Binding DailyInterest, StringFormat={}{0:#,##0.00}}" Width="110"/>
                            <DataGridTextColumn Header="Rate %" Binding="{Binding InterestRatePercent}" Width="70"/>
                            <DataGridTextColumn Header="Compound Interest" Binding="{Binding CompoundInterest, StringFormat={}{0:#,##0.00}}" Width="130"/>
                            <DataGridTextColumn Header="Payments" Binding="{Binding Payments, StringFormat={}{0:#,##0.00}}" Width="100"/>
                            <DataGridTextColumn Header="Closing Balance" Binding="{Binding ClosingBalance, StringFormat={}{0:#,##0.00}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== COVER LETTER ===================== -->
            <TabItem x:Name="CoverLetterTab" Header="Cover Letter">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="BtnGenerateLetter" Content="Generate Cover Letter" Padding="8,4" Click="BtnGenerateLetter_Click"/>
                        <Button x:Name="BtnSaveLetter" Content="Save Letter to File..." Padding="8,4" Margin="10,0,0,0" Click="BtnSaveLetter_Click"/>
                        <Button x:Name="BtnCopyLetter" Content="Copy to Clipboard" Padding="8,4" Margin="10,0,0,0" Click="BtnCopyLetter_Click"/>
                    </StackPanel>
                    <TextBox x:Name="TxtLetterOutput" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                             IsReadOnly="False"/>
                </DockPanel>
            </TabItem>

        </TabControl>

        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Panel.ZIndex="100"
              Background="#880F2742">
            <Border Width="300" Height="130" Background="White" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Please wait..." FontSize="17" FontWeight="SemiBold"
                               Foreground="#1F3B57" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="8" Margin="0,18,0,0"
                                 Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

            </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="DarkRed"/>
        </StackPanel>
    </Grid>
</Window>
